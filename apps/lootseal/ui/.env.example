# Copy to .env.local to override the values recorded in deployments/preview.json.
# Everything here is public configuration, never a secret.

# Network the app reads from and asks Lace to use: preview | preprod | undeployed
VITE_NETWORK_ID=preview
# Public indexer used for reading without a wallet
VITE_INDEXER_URI=https://indexer.preview.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URI=wss://indexer.preview.midnight.network/api/v4/graphql/ws
# The drop registry contract, and drops to feature (comma-separated)
VITE_REGISTRY_ADDRESS=
VITE_FEATURED_DROPS=
# Faucet shown in the onboarding guide
VITE_FAUCET_URL=https://midnight-tmnight-preview.nethermind.dev/
# Public site origin for link previews (Vercel sets it automatically)
# VITE_SITE_URL=https://lootseal.vercel.app
# Optional block explorer tx link; {tx} is replaced by the tx id
# VITE_EXPLORER_TX_URL=

# Local devnet (yarn env:up), e.g.:
# VITE_NETWORK_ID=undeployed
# VITE_INDEXER_URI=http://127.0.0.1:8088/api/v4/graphql
# VITE_INDEXER_WS_URI=ws://127.0.0.1:8088/api/v4/graphql/ws
