# Fulfiller configuration. Copy to .env next to compose.yml and fill in.
# .env and secrets/ are gitignored: never commit them.

# local | preview | preprod
MIDNIGHT_NETWORK=preview
# The drop to fulfil (hex contract address)
DROP_ADDRESS=
# A funded wallet that pays the fees (hex seed). It needs NIGHT designated for DUST.
FULFILLER_SEED=
# Passphrase of the publisher bundle placed at secrets/publisher.json
BUNDLE_PASSPHRASE=
# Optional
POLL_MS=15000
PORT=8787
LOG_LEVEL=info
