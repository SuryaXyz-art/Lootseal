# Dependencies
node_modules/

# Yarn Berry (node-modules linker): keep releases, ignore install state
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Build / TypeScript output
dist/
*.tsbuildinfo

# Generated compiled-contract output (regenerated by `yarn compile`).
# The .compact SOURCE files are committed on purpose - never ignore them.
**/contract/managed/
# ZK keys/zkir copied into the UI's public/ by copy:zk
**/ui/public/managed/

# Secrets and local runtime state: never commit these
.secrets/
**/.secrets/
**/.env
**/.env.local
**/.env.preprod
**/.env.preview
**/logs/
**/midnight-level-db/
**/.fast-sync-wallets/
**/.gates/
lootseal-publisher-*.json
lootseal-holder-*.json
*.passphrase

# OS / editor
.DS_Store
Thumbs.db
*.log
.vercel
**/fulfiller/secrets/
